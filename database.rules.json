{
  "rules": {
    "devices": {
      ".read": "auth != null",
      ".indexOn": ["lastSeenAt", "appVersion"],
      "$deviceId": {
        ".write": "data.exists() == false || (newData.child('token').val() === data.child('token').val())",
        ".validate": "newData.hasChildren(['token', 'appVersion', 'platform', 'lastSeenAt'])",
        "token": { ".validate": "newData.isString() && newData.val().length > 10 && newData.val().length < 4096" },
        "appVersion": { ".validate": "newData.isString()" },
        "platform":  { ".validate": "newData.isString()" },
        "lastSeenAt":{ ".validate": "newData.isNumber() && newData.val() > 0" },
        "model":     { ".validate": "newData.isString()" },
        "appId":     { ".validate": "newData.isString()" }
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".indexOn": ["sentAt"],
      "$notifId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['type', 'title', 'sentAt', 'sentBy'])"
      }
    }
  }
}
