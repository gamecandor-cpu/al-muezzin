# Secrets Gradle Plugin default placeholder file
# Add environment variables in the AI Studio Secrets panel if needed.

# ONESIGNAL_APP_ID: OneSignal App ID (UUID) from your OneSignal dashboard.
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# --- Supabase (dashboard pushes, free tier) -------------------------------------
# Both values are PUBLIC: Project Settings -> API
#   SUPABASE_URL       = Project URL   (https://<ref>.supabase.co)
#   SUPABASE_ANON_KEY  = anon / public key
# Row Level Security decides what the app and the dashboard may do.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY