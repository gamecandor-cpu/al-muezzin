# Secrets Gradle Plugin default placeholder file
# Add environment variables in the AI Studio Secrets panel if needed.

# ONESIGNAL_APP_ID: OneSignal App ID (UUID) from your OneSignal dashboard.
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# --- Firebase Cloud Messaging (admin dashboard pushes) ---------------------------
# Firebase project credentials are baked into the FCM service so we don't need
# a server-side Cloud Function on the free (Spark) plan. The app writes its
# FCM token directly to Firebase Realtime Database, and the admin dashboard
# sends pushes via the FCM HTTP v1 API using a service-account JSON it stores
# only in the admin's browser localStorage.
#
# Copy these values from Firebase Console -> Project settings -> Your apps.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_SENDER_ID=YOUR_FIREBASE_SENDER_ID
