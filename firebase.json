{
  "hosting": {
    "public": "admin-dashboard",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.aab",
      "**/*.jks",
      "**/*FCM-Key.json",
      "**/*-sa.json",
      "**/*.keystore"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "hosting": { "port": 5000 },
    "database": { "port": 9000 },
    "ui": { "enabled": true }
  }
}
